# ShadowLearn V2 staging. Keep production V1 on port 8420.
SHADOW_LEARN_HOST=127.0.0.1
SHADOW_LEARN_PORT=8421
SHADOW_LEARN_DATA=/absolute/path/to/shdwlrn-v2-breeze/data-v2
SHADOW_LEARN_BREEZE_MODEL=/absolute/path/to/shdwlrn-v2-breeze/data-v2/models/vireo-mixed4bit
SHADOW_LEARN_BREEZE_PYTHON=/absolute/path/to/shdwlrn-v2-breeze/.engines/breeze/bin/python
BREEZE_AUDIO_TOKENIZER=/absolute/path/to/shdwlrn-v2-breeze/data-v2/models/breeze-upstream/audio_tokenizer
